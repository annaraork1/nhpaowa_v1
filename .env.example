NODE_ENV=development
ASSOCIATION_ID=00000000-0000-4000-8000-000000000001
JWT_SECRET=nhpaowa-dev-secret-change-me
AUTH_STRICT=false

# Postgres — local Docker default. For Supabase see site/installation/supabase.md
# Runtime (use Transaction pooler + pgbouncer on Supabase / Vercel)
DATABASE_URL=postgresql://nhpaowa:nhpaowa@localhost:5432/nhpaowa?schema=public
# Migrations / db push (same as DATABASE_URL locally; Supabase Direct host in cloud)
DATABASE_URL_UNPOOLED=postgresql://nhpaowa:nhpaowa@localhost:5432/nhpaowa?schema=public

IDENTITY_PORT=4000
INVENTORY_PORT=4001
BUS_PORT=4002
PO_APPROVAL_THRESHOLD=10000.00

# Deploy target: docker | vercel-spa | vercel-fullstack
HOSTING_MODE=docker

# Mode A (vercel-spa): same-origin proxy targets for `npm run vercel:config`
# API_PROXY_ORIGIN=https://api.example.com
# IDENTITY_UPSTREAM=https://api.example.com
# INVENTORY_UPSTREAM=https://api.example.com
# BUS_UPSTREAM=https://api.example.com

# Mode B (vercel-fullstack): Supabase Storage for uploads + Cron secret
# SUPABASE_URL=https://YOUR_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=uploads
# STORAGE_BACKEND=supabase
# CRON_SECRET=long-random-string

# Web: absolute URLs for local Vite without a reverse proxy.
# On Vercel prefer relative paths:
#   VITE_API_BASE_URL=/api/inventory
#   VITE_IDENTITY_BASE_URL=/api/auth
#   VITE_BUS_BASE_URL=/api/bus
#   VITE_ASSOCIATION_BASE_URL=/api/association
VITE_API_BASE_URL=http://localhost:4001/api/inventory
VITE_IDENTITY_BASE_URL=http://localhost:4000/api/auth
VITE_BUS_BASE_URL=http://localhost:4002/api/bus
VITE_DEV_ROLE=SECRETARY
